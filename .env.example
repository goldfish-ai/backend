DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require
OPENAI_API_KEY=sk-your-openai-key-here
PORT=3000
FRONTEND_URL=http://localhost:3002

# Integrations (optional — can also pass token per-request in the body)
GITHUB_TOKEN=ghp_your-github-pat-here
NOTION_TOKEN=secret_your-notion-integration-token-here
SLACK_TOKEN=xoxb-your-slack-bot-token-here

# Auth
JWT_SECRET=your-super-secret-jwt-key-change-this

# Webhook secrets (optional — for signature verification)
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
SLACK_SIGNING_SECRET=your-slack-signing-secret

# Notion auto-poll: comma-separated database IDs
NOTION_POLL_DATABASES=database-id-1,database-id-2
