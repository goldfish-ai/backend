  "password": "admin@123"
}

###

### Get current user (requires auth)
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}


# ─────────────────────────────────────────────
# DOCUMENTS
# ─────────────────────────────────────────────

### Seed document (embed & insert raw text — for testing)
POST {{baseUrl}}/documents/seed
Content-Type: application/json

{
  "text": "Sprint planning 2026-05-07\n\nWe decided to prioritise the search ranking improvements this sprint. Zalmen will lead the embeddings work. Rajni takes the Notion poller fix.",
  "source": "seed",
  "author": "Test User"
}

###

### Seed document — minimal (title auto-derived from first line)
POST {{baseUrl}}/documents/seed
Content-Type: application/json

{
  "text": "Decision: use pgvector for semantic search\n\nAfter evaluating Pinecone and Weaviate we chose pgvector because it runs inside our existing Postgres instance and avoids an extra managed service."
}

###

### Seed documents in bulk (embed & insert array — for testing)
POST {{baseUrl}}/documents/seed/bulk
Content-Type: application/json

{
  "documents": [

  {

    "text": "Billing incident report INC-102\n\nDuplicate invoices were generated because failed payment events were retried multiple times during API timeout failures. The retry queue processed already completed transactions because the billing service lacked idempotency validation.",

    "title": "Duplicate Invoice Incident",

    "source": "notion",

    "author": "Rahul Sharma"

  },

  {

    "text": "Slack billing outage discussion\n\nAmit Patel identified that Redis cache invalidation lag caused stale payment states to remain active longer than expected. During concurrent retries this increased the probability of duplicate invoice creation.",

    "title": "Billing Outage Investigation",

    "source": "slack",

    "author": "Amit Patel"

  },

  {

    "text": "PR #442 - billing reliability improvements\n\nImplemented idempotency validation, distributed payment locking, and retry queue reconciliation jobs to prevent duplicate invoice generation during payment retries.",

    "title": "Billing Reliability Improvements",

    "source": "github",

    "author": "Rahul Sharma"

  },

  {

    "text": "Engineering retrospective meeting\n\nRahul Sharma explained that payment retry logic was originally designed for low traffic scenarios and became unreliable under heavy concurrency. The team agreed to redesign retry processing with stronger transactional guarantees.",

    "title": "Billing Retrospective Review",

    "source": "slack",

    "author": "Rahul Sharma"

  },

  {

    "text": "Billing queue monitoring analysis\n\nThe infrastructure team added additional monitoring and alerting for retry queue failures after repeated invoice duplication incidents impacted financial reconciliation workflows.",

    "title": "Retry Queue Monitoring Improvements",

    "source": "github",

    "author": "Amit Patel"

  },

  {

    "text": "Incident resolution summary\n\nRahul Sharma led the implementation of idempotency protection while Amit Patel investigated Redis invalidation delays affecting payment consistency. Their combined fixes reduced duplicate invoice incidents by over 90 percent.",

    "title": "Billing Incident Resolution Summary",

    "source": "notion",

    "author": "Priya Mehta"

  },

  {

    "text": "Distributed locking proposal\n\nThe billing engineering team proposed distributed payment locking to prevent concurrent workers from processing the same invoice simultaneously during retry execution.",

    "title": "Distributed Locking Proposal",

    "source": "notion",

    "author": "Rahul Sharma"

  },

  {

    "text": "Billing architecture review\n\nThe team concluded that retry queue failures were amplified by stale Redis cache states and insufficient transaction boundaries in the payment service layer.",

    "title": "Billing Architecture Review",

    "source": "slack",

    "author": "Amit Patel"

  }

]
 
 
}

###

### Create document manually
POST {{baseUrl}}/documents
Content-Type: application/json

{
  "title": "Manual Test Document",
  "content": "This is the body of the document.",
  "source": "manual",
  "author": "Test User",
  "dataCreatedAt": "2026-04-23T10:00:00Z",
  "metadata": { "tag": "test" }
}

###

### List all documents
GET {{baseUrl}}/documents

###

### Get document by ID
GET {{baseUrl}}/documents/1

###

### Delete document by ID
DELETE {{baseUrl}}/documents/1
###

### Delete document by ID

POST {{baseUrl}}/chat/sessions/7/messages
Authorization: Bearer {{token}}
Content-Type: application/json

{
 "content": "Who knows authentication best?"
}


# ─────────────────────────────────────────────
# SEARCH
# ─────────────────────────────────────────────

### Semantic search
POST {{baseUrl}}/search
Content-Type: application/json

{
  "query": "What did Zalmen say in the meeting?",
  "limit": 5,
  "threshold": 0.2
}


# ─────────────────────────────────────────────
# SUMMARY
# ─────────────────────────────────────────────

### Summarize a stored document by ID
POST {{baseUrl}}/summary
Content-Type: application/json

{
  "documentId": 1,
  "maxWords": 100
}

###

### Summarize raw text
POST {{baseUrl}}/summary
Content-Type: application/json

{
  "text": "NestJS is a framework for building efficient and scalable Node.js server-side applications.",
  "maxWords": 50
}


# ─────────────────────────────────────────────
# CHAT
# ─────────────────────────────────────────────

### List chat sessions (requires auth)
GET {{baseUrl}}/chat/sessions
Authorization: Bearer {{token}}

###

### Get messages for session (requires auth)
GET {{baseUrl}}/chat/sessions/5/messages
Authorization: Bearer {{token}}

###

###

### Delete chat session (requires auth)
DELETE {{baseUrl}}/chat/sessions/1
Authorization: Bearer {{token}}


# ─────────────────────────────────────────────
# INTEGRATIONS — MEETINGS
# ─────────────────────────────────────────────

### Ingest meeting transcript
POST {{baseUrl}}/integrations/meetings/ingest
Content-Type: application/json

{
  "title": "Meeting With Zalmen-20260423_182504-Meeting Recording",
  "date": "2026-04-23T12:55:00",
  "duration": "50m 13s",
  "transcript": [
    {
      "speaker": "Zalmen Blau",
      "timestamp": "2026-04-23T12:04:50",
      "text": ["Hello, testing, testing."]
    },
    {
      "speaker": "Rajni Barvaliya",
      "timestamp": "2026-04-23T12:04:52",
      "text": ["Yes, Ivan."]
    },
    {
      "speaker": "Zalmen Blau",
      "timestamp": "2026-04-23T12:04:53",
      "text": ["Can you hear me on the on teams?"]
    },
    {
      "speaker": "Rajni Barvaliya",
      "timestamp": "2026-04-23T12:04:57",
      "text": ["Yes."]
    },
    {
      "speaker": "Zalmen Blau",
      "timestamp": "2026-04-23T12:04:58",
      "text": ["Yes, okay, I'm hanging up there now."]
    }
  ]
}


# ─────────────────────────────────────────────
# INTEGRATIONS — SLACK
# ─────────────────────────────────────────────

### Ingest Slack channel history
POST {{baseUrl}}/integrations/slack/ingest
Content-Type: application/json

{
  "channelId": "C12345678",
  "limit": 50
}

###

### Slack Events API — URL verification challenge
POST {{baseUrl}}/slack/events
Content-Type: application/json

{
  "type": "url_verification",
  "challenge": "test-challenge-token"
}

###

### Slack Events API — incoming message event
POST {{baseUrl}}/slack/events
Content-Type: application/json

{
  "type": "event_callback",
  "event": {
    "type": "message",
    "text": "Hey team, quick update on the project.",
    "user": "U12345678",
    "channel": "C12345678",
    "ts": "1745409890.000100"
  }
}


# ─────────────────────────────────────────────
# GITHUB LIVE EVENTS  (POST /api/github/events)
# ─────────────────────────────────────────────

### GitHub live event — pull_request opened
POST {{baseUrl}}/github/events
Content-Type: application/json
X-GitHub-Event: pull_request

{
  "action": "opened",
  "repository": { "full_name": "octocat/Hello-World", "owner": { "login": "octocat" }, "name": "Hello-World" },
  "pull_request": {
    "number": 42,
    "title": "Add meeting ingestion endpoint",
    "state": "open",
    "body": "This PR adds the meetings ingestion module.",
    "html_url": "https://github.com/octocat/Hello-World/pull/42",
    "created_at": "2026-04-23T10:00:00Z",
    "merged": false,
    "user": { "login": "octocat" },
    "head": { "ref": "feature/meetings" },
    "base": { "ref": "main" }
  }
}

###

### GitHub live event — pull_request closed
POST {{baseUrl}}/github/events
Content-Type: application/json
X-GitHub-Event: pull_request

{
  "action": "closed",
  "repository": { "full_name": "octocat/Hello-World", "owner": { "login": "octocat" }, "name": "Hello-World" },
  "pull_request": {
    "number": 42,
    "title": "Add meeting ingestion endpoint",
    "state": "closed",
    "body": "This PR adds the meetings ingestion module.",
    "html_url": "https://github.com/octocat/Hello-World/pull/42",
    "created_at": "2026-04-23T10:00:00Z",
    "merged": true,
    "user": { "login": "octocat" },
    "head": { "ref": "feature/meetings" },
    "base": { "ref": "main" }
  }
}

###

### GitHub live event — issue_comment created
POST {{baseUrl}}/github/events
Content-Type: application/json
X-GitHub-Event: issue_comment

{
  "action": "created",
  "repository": { "full_name": "octocat/Hello-World" },
  "issue": {
    "number": 10,
    "title": "Bug: search returns empty results",
    "pull_request": null
  },
  "comment": {
    "id": 9876,
    "body": "I reproduced this. The threshold is too high by default.",
    "html_url": "https://github.com/octocat/Hello-World/issues/10#issuecomment-9876",
    "created_at": "2026-04-23T11:00:00Z",
    "user": { "login": "octocat" }
  }
}

###

### GitHub live event — push
POST {{baseUrl}}/github/events
Content-Type: application/json
X-GitHub-Event: push

{
  "repository": { "full_name": "octocat/Hello-World" },
  "commits": [
    {
      "id": "abc1234def5678",
      "message": "Fix null pointer in auth service",
      "timestamp": "2026-04-23T10:00:00Z",
      "url": "https://github.com/octocat/Hello-World/commit/abc1234",
      "author": { "name": "Octocat", "email": "octocat@github.com" },
      "added": [],
      "modified": ["src/auth/auth.service.ts"],
      "removed": []
    }
  ]
}


# ─────────────────────────────────────────────
# INTEGRATIONS — GITHUB
